# ─── Coordinator (Respective Cell) Portal Backend — PRODUCTION template ───────
# Copy to `.env` and fill real values. NEVER commit `.env` or real secrets.
PORT=5001
NODE_ENV=production

# ─── MongoDB Atlas (shared cluster; DB = internship_management) ───────────────
MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB_NAME=internship_management

# ─── JWT (REQUIRED — no defaults; generate with: openssl rand -hex 32) ────────
JWT_ACCESS_SECRET=<GENERATE_openssl_rand_hex_32>
JWT_REFRESH_SECRET=<GENERATE_openssl_rand_hex_32>
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
BCRYPT_ROUNDS=12

# ‼ REQUIRED — verifies student tokens for the student-facing Attendance Form
#   download. MUST EXACTLY equal the Student backend's JWT_ACCESS_SECRET (and the
#   TEC backend's STUDENT_JWT_ACCESS_SECRET). Fails fast if missing.
STUDENT_JWT_ACCESS_SECRET=<SAME_VALUE_AS_STUDENT_JWT_ACCESS_SECRET>

# ─── CORS: allowed frontend origins (comma-separated, exact, no wildcard) ─────
FRONTEND_ORIGINS=https://coordinator.<your-domain>

# ─── Cookie strategy ──────────────────────────────────────────────────────────
# Same-site → strict. Cross-site → COOKIE_SAMESITE=none (forces Secure).
# (Cookie path is fixed to '/'; COOKIE_DOMAIN is not read by the code.)
COOKIE_SAMESITE=strict
COOKIE_SECURE=true

# ─── Email (Gmail SMTP) — optional/graceful ──────────────────────────────────
# Shared mailbox across all portals. With no SMTP_HOST the mailer falls back to
# an Ethereal test inbox (preview URLs only) and never blocks startup.
# SMTP_PASS is a Gmail App Password (not the account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<gmail-address>
SMTP_PASS=<gmail-app-password>
EMAIL_FROM="Internship Management System <gmail-address>"

# TEC inbox that receives reject/terminate/completion alerts from this portal.
TEC_NOTIFY_EMAIL=collegepurposeparul@gmail.com

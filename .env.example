# Coordinator (Respective Cell) Portal frontend (Vite) — copy to `.env` for local dev.
# VITE_* vars are PUBLIC (baked into the client bundle) — never put secrets here.
#
# Points at the Coordinator backend API. For a same-machine local run keep
# localhost; only change the host if the backend runs on another machine.
VITE_API_URL=http://localhost:5001/api
